# Copy to .env (git-ignored) for compose.prod.yaml.

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Overview -> token
TUNNEL_TOKEN=

# The public address of the site, as the browser reaches it. Quack shares the
# site's origin (it's routed by path), so this is the same hostname, port 443.
TEAL_DEAL_QUACK_URL=quack:test.dorzey.net:443
